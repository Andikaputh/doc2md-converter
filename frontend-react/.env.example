# URL of the FastAPI backend.
#
# Local development: leave empty and run `npm run dev`.
# Vite will proxy /api requests to http://localhost:8000 automatically.
#
# Production (Vercel, Netlify, etc.): point this to your deployed backend,
# otherwise the built site will keep calling http://localhost:8000 and show
# "Cannot reach the conversion server" when the local backend is off.
#
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
